.venv/
__pycache__/
*.pyc
.env
config.yaml
# Config backups carry the SAME secrets as config.yaml (Jira/Supabase creds) — never track them.
config.yaml.bak
*.bak
audit.jsonl
# SWE-bench benchmark trend (EU-71) — runtime-appended one line per run; never version it so the
# trend starts clean and test runs / local gauges don't pollute the committed history.
audit/swebench_runs.jsonl
run.log
# runtime artifacts
dashboard.html
dashboard-sample.html
drill-report.md
pending_decisions.json
telegram_offset.txt
qa-reports/
.general-worktrees/
# Isolated build worktrees — transient per-run clones. The path moved to .claude/worktrees/; tracking one
# committed it as a submodule gitlink (mode 160000), which breaks clones. Never track these.
.claude/worktrees/
# automode runtime cadence marker ({"last": <ts>}) — per-machine runtime state, not source.
autonomy.json
# Mac<->server state sync: the dedicated state clone (tracks the orphan `unit-state` branch). Never
# track it from the code repo — it's a second clone living inside the repo dir. See orchestrator/sync.py.
.unit-state/
# council runtime — the transcripts (council/*.md) + index are RUNTIME minutes: the unit rewrites them
# on EVERY council and the cockpit reads them straight from disk, so they don't belong in git. Tracking
# them kept the tree permanently dirty (which used to block the promote) and let the server's
# `git reset --hard` clobber its own minutes. Untracked, they're written + shown exactly as before.
commander_notes.md
commander_chat.md
adjutant-report.md
scout-report.md
provost-report.md
quartermaster-report.md
EU-144_TPM_REPORT.md
council/*.log
council/*.md
council/index.jsonl
backups/
blocked_tickets.json
# Unit Memory — versioned DOCTRINE (memory/UNIT.md) is tracked; the officer-maintained LIVING LOG is
# runtime + server-canonical, so it survives the server's `git reset --hard` self-update (see memory.py).
memory/UNIT.live.md
memory/backups/
# runtime state — regenerated as the unit runs; never version it (avoids churn + Mac/server pull conflicts)
usage.jsonl
approvals.json
dismissed.json
group_chat.jsonl
last-standup.md
recent_projects.json
# Jira connections — holds API TOKENS (the cockpit's quick-connect store). NEVER version it; each
# machine keeps its own, and the cockpit only ever shows tokens masked. See connections.py.
jira_connections.json
# EU-190: persisted active model backend (opus|glm) — per-machine, no secrets. See backend_pref.py.
model_backend.json
# Auto-written failure post-mortems — runtime diagnostics regenerated from the audit log (forensics.py).
postmortems/
# Patrol cron/launchd runtime logs (the scheduled Scout/Provost/Quartermaster sweep writes cron.log here).
/patrol/
usage_ledger.jsonl
# Autopilot per-ticket error tally — runtime state, must not be versioned (caused dev/Mac merge churn).
error_counts.json
ROSTER.md
# Runtime state relocation (EU audit 2026-07-05, Quick Win 2): everything the orchestrator derives
# from cfg.audit_path via with_name() lives under state/ — never version any of it. The filename
# entries above are kept so stragglers at the old repo-root location stay ignored too.
state/
# Lock/tmp sidecars minted by orchestrator/locking.py next to any state file.
*.json.lock
*.json.tmp
*.jsonl.lock
*.jsonl.tmp
*.txt.lock
*.txt.tmp
# EU-335: the Technical Writer's changelog append + the ELITE cycle state dir left *.md.lock and
# .elite/ untracked in the PRIMARY checkout after a land, dirtying the tree so autopull's ff was
# blocked and the cockpit silently ran stale code (the "0 shipped" incident). These were only in a
# machine-local .git/info/exclude; commit them so a fresh checkout and the VPS main tree stay clean.
*.md.lock
*.md.tmp
.elite/
# Remaining runtime state files that were never ignored (and were mistakenly committed).
pending_specialist_approvals.json
sonnet_fallback_state.json
officer_discussion_tickets.json
proposals.json
# macOS
.DS_Store
cockpit.log
# Runtime logs
logs/
