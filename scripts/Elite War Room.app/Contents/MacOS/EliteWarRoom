#!/bin/zsh
# Elite War Room — the cockpit as a Dock app.
# Starts serve, WAITS until it's actually listening, then opens the window.
# If serve fails, opens the log so you can see why (instead of silently doing nothing).

REPO="$HOME/Projects/General"
PORT=8787
LOG="$REPO/cockpit.log"
URL="http://localhost:$PORT"

# GUI-launched apps get a minimal PATH — add the usual tool locations.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

cd "$REPO" 2>/dev/null || { osascript -e 'display alert "Elite War Room" message "Repo not found at ~/Projects/General"'; exit 1; }
[[ -f .venv/bin/activate ]] && source .venv/bin/activate
[[ -f .env ]] && { set -a; source .env; set +a; }

{ echo; echo "=== $(date '+%Y-%m-%d %H:%M:%S') launching cockpit ==="; } >> "$LOG" 2>&1

# Stop any cockpit already bound to the port (this doubles as "refresh")
PIDS=$(lsof -ti tcp:$PORT 2>/dev/null)
[[ -n "$PIDS" ]] && { kill $PIDS 2>/dev/null; sleep 1; PIDS=$(lsof -ti tcp:$PORT 2>/dev/null); [[ -n "$PIDS" ]] && kill -9 $PIDS 2>/dev/null; }

# Sweep up any leftover War Room *terminal* windows from the .command launcher — the server was just
# stopped, so they're idle and close without a prompt. The app runs the cockpit in the background (no
# terminal of its own), so it just clears the strays. Matched by the cockpit URL/banner in scrollback.
/usr/bin/osascript >/dev/null 2>&1 <<'OSA'
tell application "Terminal"
  repeat with w in windows
    try
      set htxt to (history of selected tab of w)
      if (htxt contains "localhost:8787") or (htxt contains "War Room") or (htxt contains "general serve") then
        close w saving no
      end if
    end try
  end repeat
end tell
OSA

# Start the cockpit in the background, logging everything
./general serve >> "$LOG" 2>&1 &
SERVE_PID=$!

# Wait until it's actually listening (up to ~30s). If serve dies, show the log.
for i in {1..60}; do
  if curl -s -o /dev/null "$URL" 2>/dev/null; then break; fi
  if ! kill -0 "$SERVE_PID" 2>/dev/null; then
    osascript -e 'display alert "Elite War Room failed to start" message "Opening cockpit.log so you can see the error."' 2>/dev/null
    open -a TextEdit "$LOG"
    exit 1
  fi
  sleep 0.5
done

# Open the cockpit (always produces a tab), THEN keep exactly one: close any duplicate localhost:8787
# tabs. The dedupe needs Chrome/Safari Automation permission (granted once: System Settings > Privacy &
# Security > Automation > "Elite War Room" > the browser). Without it you still get a working tab — it
# just won't auto-dedupe.
open "$URL"
sleep 1
/usr/bin/osascript >/dev/null 2>&1 <<'OSA'
on dedupe(appName)
  tell application "System Events"
    if not (exists (processes whose name is appName)) then return
  end tell
  tell application appName
    set kept to false
    repeat with w in windows
      try
        repeat with i from (count of tabs of w) to 1 by -1
          if (URL of tab i of w) contains "localhost:8787" then
            if kept then
              close tab i of w
            else
              set kept to true
            end if
          end if
        end repeat
      end try
    end repeat
  end tell
end dedupe
dedupe("Google Chrome")
dedupe("Safari")
OSA

# Keep the app alive while the cockpit runs (Quit the app = stop the cockpit)
wait "$SERVE_PID"
