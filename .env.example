# Copy to .env and `source` it (the ./general wrapper sources it automatically).
# Never commit the real .env.

# ---------------------------------------------------------------------------
# AUTH for the officers (Claude Code). Pick ONE:
#
# A) Max / Pro subscription (recommended for you — no per-token bill):
#    Easiest on your Mac: just run `claude` once and /login. Nothing to set here.
#    For headless/cron, generate a 1-year token and set it:
#        claude setup-token        # prints sk-ant-oat01-...
#    export CLAUDE_CODE_OAUTH_TOKEN="sk-ant-oat01-..."
#
# B) Per-token API billing (only if you prefer it):
#    export ANTHROPIC_API_KEY="sk-ant-..."
#
# NOTE: if ANTHROPIC_API_KEY is set it WINS over the subscription and you get an
# API invoice. On Max, leave it unset.
# ---------------------------------------------------------------------------

# Jira Cloud — only needed for `ticket` / `drain` (not for `task --spec-file`).
# Create a token at id.atlassian.com -> Security -> API tokens.
export JIRA_EMAIL="romario.berlin@gmail.com"
export JIRA_API_TOKEN="..."

# Telegram alerts (optional but recommended). Setup:
#   1) In Telegram, message @BotFather -> /newbot -> copy the token.
#   2) Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
#   3) Paste both below. Test with: ./general ping
export TELEGRAM_BOT_TOKEN="..."
export TELEGRAM_CHAT_ID="..."

# Notion (only if an app uses backlog_backend: notion)
# export NOTION_TOKEN="secret_..."
